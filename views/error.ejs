<% layout("/layouts/boilerplate") %>
<% 
    const is404 = (typeof statusCode !== 'undefined' && statusCode === 404) || 
                  (typeof message === 'string' && message.toLowerCase().includes('not found'));
    const displayTitle = is404 ? "Page Not Found" : "Something Went Wrong";
    const displayDesc = is404 ? "The page you are looking for does not exist or has been moved." : (message || "An unexpected error occurred. Please try again later.");
%>
<div class="row mt-5 animate__animated animate__fadeIn">
    <div class="col-md-8 offset-md-2 text-center py-4">
        <div class="error-container-card p-5 rounded-5 shadow-lg position-relative overflow-hidden">
            <!-- Decorative Background Element -->
            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at top right, rgba(255, 56, 92, 0.08), transparent); z-index: 0;"></div>
            
            <div class="mb-4 position-relative" style="z-index: 1;">
                <div class="d-inline-flex align-items-center justify-content-center mb-3 rounded-circle" style="width: 80px; height: 80px; background: rgba(255, 56, 92, 0.1);">
                    <i class="fa-solid <%= is404 ? 'fa-map-location-dot' : 'fa-triangle-exclamation' %> text-danger fs-1"></i>
                </div>
                <h1 class="display-5 fw-bold mb-2" style="letter-spacing: -0.5px;"><%= displayTitle %></h1>
                <p class="fs-5 text-muted mb-4"><%= displayDesc %></p>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 position-relative" style="z-index: 1;">
                <a href="/" class="btn btn-danger btn-lg px-4 py-3 fw-bold rounded-pill shadow-sm" style="background: linear-gradient(135deg, #ff385c, #e03150); border: none;">
                    <i class="fa-solid fa-house me-2"></i>Return to Home Page
                </a>
                <a href="/listings" class="btn btn-outline-danger btn-lg px-4 py-3 fw-bold rounded-pill shadow-sm">
                    <i class="fa-solid fa-compass me-2"></i>Explore Listings
                </a>
            </div>

            <div class="mt-5 pt-4 border-top position-relative" style="z-index: 1;">
                <p class="text-muted small mb-0">Need assistance? <a href="/messages" class="text-danger text-decoration-none fw-bold">Contact Concierge Support</a></p>
            </div>
        </div>
    </div>
</div>

<style>
    .error-container-card {
        background: #ffffff;
        color: #212529;
        border: 1px solid #e0e0e0;
        transition: transform 0.3s ease;
    }
    .error-msg-box {
        background: #fff5f6;
        color: #212529;
    }

    [data-bs-theme="dark"] .error-container-card {
        background: #1e2227 !important;
        color: #f8f9fa !important;
        border: 1px solid #343a40 !important;
    }
    [data-bs-theme="dark"] .error-msg-box {
        background: #2b3035 !important;
        color: #f8f9fa !important;
    }

    .error-container-card:hover {
        transform: translateY(-4px);
    }
</style>



