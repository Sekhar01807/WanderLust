<!-- Host Reservations Received Tab -->
<% if (typeof hostReservations !== 'undefined' && userListings.length > 0) { %>
<div class="tab-pane fade" id="host-reservations-tab-pane" role="tabpanel" aria-labelledby="host-reservations-tab" tabindex="0">
    <% if(hostReservations.length === 0) { %>
        <div class="text-center mt-5 text-muted">
            <i class="fa-solid fa-calendar-xmark mb-3" style="font-size: 3rem; color: #ccc;"></i>
            <h5>No reservations received yet for your listings.</h5>
            <p class="small text-muted">When travelers book your stays, their booking details will appear here!</p>
        </div>
    <% } else { %>
        <div class="row row-cols-1 g-4">
            <% for(let booking of hostReservations) { %>
                <div class="col">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-row">
                        <img src="<%= booking.listing ? booking.listing.image.url : '' %>" style="width: 200px; height: 150px; object-fit: cover;" alt="<%= booking.listing ? booking.listing.title : 'Stay' %>">
                        <div class="card-body p-4 d-flex flex-column justify-content-center">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h5 class="fw-bold mb-0"><%= booking.listing ? booking.listing.title : 'Property' %></h5>
                                <% const isHostPast = new Date() > new Date(booking.checkOut); %>
                                <% if (booking.paymentStatus === 'cancelled') { %>
                                    <span class="badge bg-secondary py-2 px-3"><i class="fa-solid fa-circle-xmark me-1"></i>Cancelled by Guest</span>
                                <% } else if (booking.paymentStatus === 'no_show') { %>
                                    <span class="badge bg-warning text-dark py-2 px-3"><i class="fa-solid fa-user-slash me-1"></i>No-Show</span>
                                <% } else if (isHostPast || booking.paymentStatus === 'completed') { %>
                                    <span class="badge bg-primary py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i>Completed Stay</span>
                                <% } else { %>
                                    <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i>Confirmed / Upcoming</span>
                                <% } %>
                            </div>

                            <p class="mb-1 text-muted"><i class="fa-solid fa-user me-2 text-danger"></i>Guest: <strong>@<%= booking.user ? booking.user.username : 'Guest' %></strong> (<%= booking.user ? booking.user.email : '' %>)</p>
                            <p class="text-muted mb-1 small"><i class="fa-solid fa-calendar-days me-2 text-danger"></i><strong>Dates:</strong> <%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %> &rarr; <%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %> &bull; <i class="fa-solid fa-users me-1 ms-1 text-primary"></i><strong>Guests:</strong> <%= booking.guests %> Guests</p>
                            <div class="mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span class="fw-bold text-success fs-5">Host Revenue: ₹<%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : '0' %></span>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#hostModal_<%= booking._id %>">
                                        <i class="fa-solid fa-circle-info me-1"></i>Guest Details
                                    </button>
                                    <% if (booking.user) { %>
                                    <a href="/messages?receiverId=<%= booking.user._id %>&listingId=<%= booking.listing ? booking.listing._id : '' %>" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                        <i class="fa-regular fa-comment-dots me-1"></i>Message Guest
                                    </a>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Host Detailed Guest Modal -->
                            <div class="modal fade" id="hostModal_<%= booking._id %>" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0 shadow-lg">
                                        <div class="modal-header border-bottom p-4" style="background: linear-gradient(135deg, #ff385c, #e03150); color: white;">
                                            <h5 class="modal-title fw-bold text-white mb-0"><i class="fa-solid fa-id-card me-2"></i>Reservation & Guest Details</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <!-- Guest Card Info -->
                                            <div class="d-flex align-items-center mb-3 p-3 rounded-4 bg-light border border-light-subtle shadow-sm">
                                                <% if (booking.user && booking.user.profileImage && booking.user.profileImage.url) { %>
                                                    <img src="<%= booking.user.profileImage.url %>" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid #ff385c;" alt="<%= booking.user.username %>">
                                                <% } else { %>
                                                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-3 fw-bold fs-4" style="width: 50px; height: 50px;">
                                                        <%= booking.user ? booking.user.username.charAt(0).toUpperCase() : 'G' %>
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark">@<%= booking.user ? booking.user.username : 'Guest' %></h6>
                                                    <small class="text-muted"><i class="fa-solid fa-envelope me-1 text-danger"></i><%= booking.user ? booking.user.email : 'No email' %></small>
                                                </div>
                                            </div>

                                            <div class="row g-2 mb-3">
                                                <div class="col-6">
                                                    <div class="p-2 rounded-3 bg-white border shadow-sm h-100">
                                                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Location</small>
                                                        <span class="fw-semibold text-dark small"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= (booking.user && booking.user.country) ? booking.user.country : 'Not specified' %></span>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="p-2 rounded-3 bg-white border shadow-sm h-100">
                                                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Phone</small>
                                                        <span class="fw-semibold text-dark small"><i class="fa-solid fa-phone me-1 text-success"></i><%= (booking.user && booking.user.phoneNumber) ? booking.user.phoneNumber : 'Not provided' %></span>
                                                    </div>
                                                </div>
                                                <% if (booking.user && booking.user.bio) { %>
                                                <div class="col-12">
                                                    <div class="p-2 rounded-3 bg-white border shadow-sm">
                                                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Guest Bio</small>
                                                        <span class="text-muted small"><%= booking.user.bio %></span>
                                                    </div>
                                                </div>
                                                <% } %>
                                            </div>

                                            <!-- Stay Information Container -->
                                            <div class="d-flex align-items-center mb-2 mt-4">
                                                <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                                    <i class="fa-solid fa-house fs-6"></i>
                                                </div>
                                                <h6 class="fw-bold mb-0 text-danger" style="font-size: 0.95rem;">Stay Information</h6>
                                            </div>

                                            <div class="p-3 rounded-4 bg-light border border-light-subtle shadow-sm">
                                                <div class="mb-3 pb-2 border-bottom">
                                                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Property</small>
                                                    <div class="fw-bold text-dark fs-6"><i class="fa-solid fa-hotel me-2 text-danger"></i><%= booking.listing ? booking.listing.title : 'Stay' %></div>
                                                    <small class="text-muted ms-4"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing ? booking.listing.location : '' %></small>
                                                </div>

                                                <div class="row g-2 mb-3 pb-2 border-bottom">
                                                    <div class="col-6">
                                                        <div class="p-2 rounded-3 bg-white border shadow-sm">
                                                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;"><i class="fa-solid fa-calendar-check text-success me-1"></i>Check-In</small>
                                                            <span class="fw-bold text-dark small"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric' }) %></span>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="p-2 rounded-3 bg-white border shadow-sm">
                                                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;"><i class="fa-solid fa-calendar-xmark text-danger me-1"></i>Check-Out</small>
                                                            <span class="fw-bold text-dark small"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric' }) %></span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row g-2 align-items-center">
                                                    <div class="col-6">
                                                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Guest Count</small>
                                                        <span class="fw-bold text-dark small"><i class="fa-solid fa-users me-1 text-primary"></i><%= booking.guests %> Guests</span>
                                                    </div>
                                                    <div class="col-6 text-end">
                                                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Total Payout</small>
                                                        <span class="fs-6 fw-bold text-success px-3 py-1 bg-success-subtle rounded-pill border border-success-subtle d-inline-block">
                                                            ₹<%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : '0' %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-top p-3">
                                            <% if (booking.user) { %>
                                            <a href="/messages?receiverId=<%= booking.user._id %>&listingId=<%= booking.listing ? booking.listing._id : '' %>" class="btn btn-danger rounded-pill px-4 fw-bold w-100" style="background: linear-gradient(135deg, #ff385c, #e03150); border: none;">
                                                <i class="fa-regular fa-comment-dots me-2"></i>Open Chat with @<%= booking.user.username %>
                                            </a>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>
<% } %>
