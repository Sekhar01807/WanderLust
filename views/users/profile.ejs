<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-12">
        <%- include("../includes/flash.ejs") %>
    </div>
    <div class="col-12 col-md-4 mb-4">
        <!-- Profile Info Card -->
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <div class="position-relative d-inline-block mb-3" style="cursor: pointer;" onclick="document.getElementById('profileImage').click();">
                    <% if(user.profileImage && user.profileImage.url && !user.profileImage.url.includes("dwy7q5x2g") && user.profileImage.url !== "") { %>
                        <img id="profile-preview" src="<%= user.profileImage.url %>" alt="Profile Image" class="rounded-circle img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;">
                    <% } else { %>
                        <div id="profile-preview-fallback" class="rounded-circle img-thumbnail d-flex justify-content-center align-items-center bg-danger text-white mx-auto" style="width: 150px; height: 150px; font-size: 4rem;">
                            <%= user.username.charAt(0).toUpperCase() %>
                        </div>
                        <img id="profile-preview" src="" style="display:none; width: 150px; height: 150px; object-fit: cover;" class="rounded-circle img-thumbnail">
                    <% } %>
                    
                    <!-- Hover Edit Overlay -->
                    <div class="position-absolute top-0 start-0 w-100 h-100 rounded-circle d-flex justify-content-center align-items-center profile-overlay" style="background: rgba(0,0,0,0.4); opacity: 0; transition: 0.2s;">
                        <i class="fa-solid fa-camera text-white" style="font-size: 2rem;"></i>
                    </div>
                </div>
                <h4 class="card-title">@<%= user.username %></h4>
                <% const isHost = (userListings.length > 0 || user.role === 'Host'); %>
                <p class="mb-2"><span class="badge <%= isHost ? 'bg-danger' : 'bg-primary' %> rounded-pill px-3"><%= isHost ? 'Host' : 'Traveler' %></span></p>
                <p class="text-muted small mb-3 px-3"><%= user.bio || 'No bio yet.' %></p>
                <div class="text-start px-3 small mb-3">
                    <p class="text-muted mb-1"><i class="fa-solid fa-envelope me-2"></i> <%= user.email %></p>
                    <p class="text-muted mb-1"><i class="fa-solid fa-location-dot me-2"></i> <%= user.country || 'Not specified' %></p>
                    <p class="text-muted mb-1"><i class="fa-solid fa-phone me-2"></i> <%= user.phoneNumber || 'Add phone' %></p>
                    <p class="text-muted mb-1"><i class="fa-solid fa-language me-2"></i> <%= user.languages || 'English' %></p>
                </div>
                
                <hr>
                
                <button id="toggleEditProfileBtn" type="button" class="btn btn-outline-danger w-100 rounded-pill py-2 fw-bold mb-2">
                    <i class="fa-solid fa-user-pen me-2"></i>Edit Profile
                </button>
                
                <div id="editProfileSection" style="display: none;" class="mt-3 text-start animate__animated animate__fadeIn">
                    <h5 class="mb-3 fw-bold text-center" style="color: #ff385c;">Edit Profile Details</h5>
                    <form action="/profile?_method=PUT" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label for="username" class="form-label text-muted small fw-bold">Username</label>
                            <input type="text" class="form-control rounded-3" id="username" name="username" value="<%= user.username %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="role" class="form-label text-muted small fw-bold">Account Type</label>
                            <% if (userListings.length > 0) { %>
                                <input type="text" class="form-control rounded-3 bg-light text-muted" value="Host (Listing Owner)" readonly>
                                <input type="hidden" name="role" value="Host">
                                <div class="form-text small text-muted">You own active stay(s), so your profile is automatically set as Host.</div>
                            <% } else { %>
                                <select class="form-select rounded-3" id="role" name="role">
                                    <option value="Traveler" <%= user.role === 'Traveler' ? 'selected' : '' %>>Traveler (Explore & Book)</option>
                                    <option value="Host" <%= user.role === 'Host' ? 'selected' : '' %>>Host (List & Manage Hotels)</option>
                                </select>
                            <% } %>
                        </div>

                        <div class="mb-3">
                            <label for="bio" class="form-label text-muted small fw-bold">Bio</label>
                            <textarea class="form-control rounded-3" id="bio" name="bio" rows="2" placeholder="Tell us about yourself..."><%= user.bio %></textarea>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="country" class="form-label text-muted small fw-bold">Country</label>
                                <input type="text" class="form-control rounded-3" id="country" name="country" value="<%= user.country %>" required>
                            </div>
                            <div class="col-6">
                                <label for="phoneNumber" class="form-label text-muted small fw-bold">Phone</label>
                                <input type="text" class="form-control rounded-3" id="phoneNumber" name="phoneNumber" value="<%= user.phoneNumber %>" placeholder="+123...">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="languages" class="form-label text-muted small fw-bold">Languages Spoken</label>
                            <input type="text" class="form-control rounded-3" id="languages" name="languages" value="<%= user.languages %>" placeholder="e.g. English, Hindi">
                        </div>
                        <input type="file" id="profileImage" name="profileImage" accept=".png, .jpg, .jpeg, .webp, image/*" style="display: none;">
                        <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-3" style="background-color: #ff385c; border: none;">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-md-8">
        <% if (typeof hostStats !== 'undefined' && userListings.length > 0) { %>
        <!-- Host Analytics Dashboard Banner (Theme Adaptive) -->
        <div class="card border shadow-sm rounded-4 mb-4 host-dashboard-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1"><i class="fa-solid fa-chart-line me-2 text-danger"></i>Host Performance Dashboard</h5>
                        <small class="text-muted">Stored Reservation Audit Logs & Analytics</small>
                    </div>
                    <span class="badge rounded-pill bg-danger px-3 py-2 fw-bold">Active Host</span>
                </div>
                <div class="row g-3 text-center">
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 host-metric-box">
                            <small class="text-muted d-block mb-1 fw-bold">Total Revenue</small>
                            <span class="fs-5 fw-bold text-success">₹<%= hostStats.totalEarnings.toLocaleString("en-IN") %></span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 host-metric-box">
                            <small class="text-muted d-block mb-1 fw-bold">Active Bookings</small>
                            <span class="fs-5 fw-bold text-warning"><%= hostStats.activeBookings %></span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 host-metric-box">
                            <small class="text-muted d-block mb-1 fw-bold">Completed Stays</small>
                            <span class="fs-5 fw-bold text-info"><%= hostStats.completedStays %></span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3 host-metric-box">
                            <small class="text-muted d-block mb-1 fw-bold">Cancelled Trips</small>
                            <span class="fs-5 fw-bold text-danger"><%= hostStats.cancelledBookings %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Tabs for Listings, Wishlist, and Bookings -->
        <ul class="nav nav-tabs mb-4 flex-nowrap overflow-auto" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-tab-pane" type="button" role="tab" aria-controls="bookings-tab-pane" aria-selected="true" style="color: crimson; font-weight: bold;">
                    My Bookings (<%= userBookings.length %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="listings-tab" data-bs-toggle="tab" data-bs-target="#listings-tab-pane" type="button" role="tab" aria-controls="listings-tab-pane" aria-selected="false">
                    My Listings (<%= userListings.length %>)
                </button>
            </li>
            <% if (typeof hostReservations !== 'undefined' && userListings.length > 0) { %>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="host-reservations-tab" data-bs-toggle="tab" data-bs-target="#host-reservations-tab-pane" type="button" role="tab" aria-controls="host-reservations-tab-pane" aria-selected="false" style="color: #ff385c; font-weight: bold;">
                    <i class="fa-solid fa-bell me-1"></i>Reservations Received (<%= hostReservations.length %>)
                </button>
            </li>
            <% } %>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist-tab-pane" type="button" role="tab" aria-controls="wishlist-tab-pane" aria-selected="false">
                    My Wishlist (<%= user.wishlist.length %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-tab-pane" type="button" role="tab" aria-controls="reviews-tab-pane" aria-selected="false">
                    My Reviews (<%= reviewsWithListings.length %>)
                </button>
            </li>
        </ul>

        
        <div class="tab-content" id="profileTabsContent">
            <!-- Bookings Tab -->
            <div class="tab-pane fade show active" id="bookings-tab-pane" role="tabpanel" aria-labelledby="bookings-tab" tabindex="0">
                <% if(userBookings.length === 0) { %>
                    <div class="text-center mt-5 text-muted">
                        <i class="fa-solid fa-plane-arrival mb-3" style="font-size: 3rem; color: #ccc;"></i>
                        <h5>No upcoming trips.</h5>
                        <a href="/listings" class="btn btn-outline-danger mt-2">Find a place to stay</a>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 g-4">
                        <% for(let booking of userBookings) { %>
                            <div class="col">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-row">
                                    <img src="<%= booking.listing ? booking.listing.image.url : '' %>" style="width: 200px; height: 150px; object-fit: cover;">
                                    <div class="card-body p-4 d-flex flex-column justify-content-center">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h5 class="fw-bold mb-0"><%= booking.listing ? booking.listing.title : 'Property' %></h5>
                                            <% const isPast = new Date() > new Date(booking.checkOut); %>
                                            <% if (booking.paymentStatus === 'cancelled') { %>
                                                <span class="badge bg-danger py-2 px-3"><i class="fa-solid fa-ban me-1"></i>Cancelled</span>
                                            <% } else if (booking.paymentStatus === 'no_show') { %>
                                                <span class="badge bg-warning text-dark py-2 px-3"><i class="fa-solid fa-user-slash me-1"></i>No-Show</span>
                                            <% } else if (isPast || booking.paymentStatus === 'completed') { %>
                                                <span class="badge bg-primary py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i>Completed Stay</span>
                                            <% } else { %>
                                                <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-plane-departure me-1"></i>Confirmed Stay</span>
                                            <% } %>
                                        </div>
                                        <p class="text-muted mb-1 small"><i class="fa-solid fa-calendar-days me-2 text-danger"></i><strong>Dates:</strong> <%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %> &rarr; <%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %></p>
                                        <p class="text-muted mb-0 small"><i class="fa-solid fa-users me-2 text-primary"></i><strong>Guests:</strong> <%= booking.guests %> Guests</p>
                                        <div class="mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <a href="/listings/<%= booking.listing ? booking.listing._id : '' %>" class="btn btn-sm btn-dark rounded-pill px-3 me-2">View Stay</a>
                                                <% if (booking.paymentStatus === 'paid' || booking.paymentStatus === 'completed' || isPast) { %>
                                                    <a href="/receipt/<%= booking._id %>" target="_blank" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                                        <i class="fa-solid fa-file-pdf text-danger me-1"></i>Download PDF Receipt
                                                    </a>
                                                <% } %>


                                            </div>
                                            <% if (booking.paymentStatus !== 'cancelled' && !isPast) { %>
                                                <form method="POST" action="/listings/<%= booking.listing ? booking.listing._id : '' %>/booking/<%= booking._id %>?_method=DELETE" class="d-inline">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to cancel this reservation?')">
                                                        <i class="fa-solid fa-xmark me-1"></i>Cancel Trip
                                                    </button>
                                                </form>
                                            <% } %>

                                        </div>

                                    </div>
                                </div>
                            </div>

                        <% } %>

                    </div>
                <% } %>
            </div>

            <!-- Listings Tab -->
            <div class="tab-pane fade" id="listings-tab-pane" role="tabpanel" aria-labelledby="listings-tab" tabindex="0">
                <% if(userListings.length === 0) { %>
                    <div class="text-center mt-5 text-muted">
                        <i class="fa-solid fa-house mb-3" style="font-size: 3rem; color: #ccc;"></i>
                        <h5>You haven't created any listings yet.</h5>
                        <a href="/listings/new" class="btn btn-outline-danger mt-2">Create New Listing</a>
                    </div>
                <% } else { %>
                    <div class="row row-cols-lg-2 row-cols-md-2 row-cols-sm-1">
                        <% for(let listing of userListings) { %>
                            <div class="card listing-card mb-4" style="border: 1px solid #ddd !important; border-radius: 1rem; overflow: hidden;">
                                <a href="/listings/<%= listing._id %>" class="listing-link">
                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="image" style="height: 15rem; object-fit: cover;">
                                </a>
                                <div class="card-body p-3">
                                    <h5 class="card-title text-truncate"><%= listing.title %></h5>
                                    <p class="card-text text-muted mb-2"><i class="fa-solid fa-location-dot"></i> <%= listing.location %></p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold">&#8377 <%= listing.price ? listing.price.toLocaleString() : "N/A" %></span>
                                        <div>
                                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-pen"></i></a>
                                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline delete-listing-form">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="button" class="btn btn-sm btn-outline-danger delete-listing-btn"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
                     <!-- Host Reservations Received Tab -->
            <% if (typeof hostReservations !== 'undefined' && userListings.length > 0) { %>
            <div class="tab-pane fade" id="host-reservations-tab-pane" role="tabpanel" aria-labelledby="host-reservations-tab" tabindex="0">
                <% if(hostReservations.length === 0) { %>
                    <div class="text-center mt-5 text-muted">
                        <i class="fa-solid fa-calendar-xmark mb-3" style="font-size: 3rem; color: #ccc;"></i>
                        <h5>No reservations received yet for your listings.</h5>
                        <p class="small text-muted">When travelers book your stays, their booking details will appear here!</p>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 g-4">
                        <% for(let booking of hostReservations) { %>
                            <div class="col">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-row">
                                    <img src="<%= booking.listing ? booking.listing.image.url : '' %>" style="width: 200px; height: 150px; object-fit: cover;">
                                    <div class="card-body p-4 d-flex flex-column justify-content-center">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h5 class="fw-bold mb-0"><%= booking.listing ? booking.listing.title : 'Property' %></h5>
                                            <% const isHostPast = new Date() > new Date(booking.checkOut); %>
                                            <% if (booking.paymentStatus === 'cancelled') { %>
                                                <span class="badge bg-secondary py-2 px-3"><i class="fa-solid fa-circle-xmark me-1"></i>Cancelled by Guest</span>
                                            <% } else if (booking.paymentStatus === 'no_show') { %>
                                                <span class="badge bg-warning text-dark py-2 px-3"><i class="fa-solid fa-user-slash me-1"></i>No-Show</span>
                                            <% } else if (isHostPast || booking.paymentStatus === 'completed') { %>
                                                <span class="badge bg-primary py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i>Completed Stay</span>
                                            <% } else { %>
                                                <span class="badge bg-success py-2 px-3"><i class="fa-solid fa-circle-check me-1"></i>Confirmed / Upcoming</span>
                                            <% } %>
                                        </div>

                                        <p class="mb-1 text-muted"><i class="fa-solid fa-user me-2 text-danger"></i>Guest: <strong>@<%= booking.user ? booking.user.username : 'Guest' %></strong> (<%= booking.user ? booking.user.email : '' %>)</p>
                                        <p class="text-muted mb-1 small"><i class="fa-solid fa-calendar-days me-2 text-danger"></i><strong>Dates:</strong> <%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %> &rarr; <%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %> &bull; <i class="fa-solid fa-users me-1 ms-1 text-primary"></i><strong>Guests:</strong> <%= booking.guests %> Guests</p>
                                        <div class="mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <span class="fw-bold text-success fs-5">Host Revenue: ₹<%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : '0' %></span>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#hostModal_<%= booking._id %>">
                                                    <i class="fa-solid fa-circle-info me-1"></i>Guest Details
                                                </button>
                                                <% if (booking.user) { %>
                                                <a href="/messages?receiverId=<%= booking.user._id %>&listingId=<%= booking.listing ? booking.listing._id : '' %>" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                                    <i class="fa-regular fa-comment-dots me-1"></i>Message Guest
                                                </a>
                                                <% } %>
                                            </div>
                                        </div>

                                        <!-- Host Detailed Guest Modal -->
                                        <div class="modal fade" id="hostModal_<%= booking._id %>" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow-lg">
                                                    <div class="modal-header border-bottom p-4" style="background: linear-gradient(135deg, #ff385c, #e03150); color: white;">
                                                        <h5 class="modal-title fw-bold text-white mb-0"><i class="fa-solid fa-id-card me-2"></i>Reservation & Guest Details</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <!-- Guest Card Info -->
                                                        <div class="d-flex align-items-center mb-3 p-3 rounded-4 bg-light border border-light-subtle shadow-sm">
                                                            <% if (booking.user && booking.user.profileImage && booking.user.profileImage.url) { %>
                                                                <img src="<%= booking.user.profileImage.url %>" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid #ff385c;">
                                                            <% } else { %>
                                                                <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-3 fw-bold fs-4" style="width: 50px; height: 50px;">
                                                                    <%= booking.user ? booking.user.username.charAt(0).toUpperCase() : 'G' %>
                                                                </div>
                                                            <% } %>
                                                            <div>
                                                                <h6 class="fw-bold mb-0 text-dark">@<%= booking.user ? booking.user.username : 'Guest' %></h6>
                                                                <small class="text-muted"><i class="fa-solid fa-envelope me-1 text-danger"></i><%= booking.user ? booking.user.email : 'No email' %></small>
                                                            </div>
                                                        </div>

                                                        <div class="row g-2 mb-3">
                                                            <div class="col-6">
                                                                <div class="p-2.5 rounded-3 bg-white border shadow-sm h-100">
                                                                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Location</small>
                                                                    <span class="fw-semibold text-dark small"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= (booking.user && booking.user.country) ? booking.user.country : 'Not specified' %></span>
                                                                </div>
                                                            </div>
                                                            <div class="col-6">
                                                                <div class="p-2.5 rounded-3 bg-white border shadow-sm h-100">
                                                                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Phone</small>
                                                                    <span class="fw-semibold text-dark small"><i class="fa-solid fa-phone me-1 text-success"></i><%= (booking.user && booking.user.phoneNumber) ? booking.user.phoneNumber : 'Not provided' %></span>
                                                                </div>
                                                            </div>
                                                            <% if (booking.user && booking.user.bio) { %>
                                                            <div class="col-12">
                                                                <div class="p-2.5 rounded-3 bg-white border shadow-sm">
                                                                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Guest Bio</small>
                                                                    <span class="text-muted small"><%= booking.user.bio %></span>
                                                                </div>
                                                            </div>
                                                            <% } %>
                                                        </div>

                                                        <!-- Stay Information Container -->
                                                        <div class="d-flex align-items-center mb-2 mt-4">
                                                            <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                                                <i class="fa-solid fa-house fs-6"></i>
                                                            </div>
                                                            <h6 class="fw-bold mb-0 text-danger" style="font-size: 0.95rem;">Stay Information</h6>
                                                        </div>

                                                        <div class="p-3 rounded-4 bg-light border border-light-subtle shadow-sm">
                                                            <!-- Property Title & Location -->
                                                            <div class="mb-3 pb-2 border-bottom">
                                                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Property</small>
                                                                <div class="fw-bold text-dark fs-6"><i class="fa-solid fa-hotel me-2 text-danger"></i><%= booking.listing ? booking.listing.title : 'Stay' %></div>
                                                                <small class="text-muted ms-4"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing ? booking.listing.location : '' %></small>
                                                            </div>

                                                            <!-- Check-In / Check-Out Grid -->
                                                            <div class="row g-2 mb-3 pb-2 border-bottom">
                                                                <div class="col-6">
                                                                    <div class="p-2 rounded-3 bg-white border shadow-sm">
                                                                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;"><i class="fa-solid fa-calendar-check text-success me-1"></i>Check-In</small>
                                                                        <span class="fw-bold text-dark small"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric' }) %></span>
                                                                    </div>
                                                                </div>
                                                                <div class="col-6">
                                                                    <div class="p-2 rounded-3 bg-white border shadow-sm">
                                                                        <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;"><i class="fa-solid fa-calendar-xmark text-danger me-1"></i>Check-Out</small>
                                                                        <span class="fw-bold text-dark small"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric' }) %></span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Guests & Total Payout -->
                                                            <div class="row g-2 align-items-center">
                                                                <div class="col-6">
                                                                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Guest Count</small>
                                                                    <span class="fw-bold text-dark small"><i class="fa-solid fa-users me-1 text-primary"></i><%= booking.guests %> Guests</span>
                                                                </div>
                                                                <div class="col-6 text-end">
                                                                    <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Total Payout</small>
                                                                    <span class="fs-6 fw-bold text-success px-3 py-1 bg-success-subtle rounded-pill border border-success-subtle d-inline-block">
                                                                        ₹<%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : '0' %>
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top p-3">
                                                        <% if (booking.user) { %>
                                                        <a href="/messages?receiverId=<%= booking.user._id %>&listingId=<%= booking.listing ? booking.listing._id : '' %>" class="btn btn-danger rounded-pill px-4 fw-bold w-100" style="background: linear-gradient(135deg, #ff385c, #e03150); border: none;">
                                                            <i class="fa-regular fa-comment-dots me-2"></i>Open Chat with @<%= booking.user.username %>
                                                        </a>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
            <% } %>

            <!-- Wishlist Tab -->

            <div class="tab-pane fade" id="wishlist-tab-pane" role="tabpanel" aria-labelledby="wishlist-tab" tabindex="0">

                <% if(user.wishlist.length === 0) { %>
                    <div class="text-center mt-5 text-muted">
                        <i class="fa-solid fa-heart mb-3" style="font-size: 3rem; color: #ccc;"></i>
                        <h5>Your wishlist is empty.</h5>
                        <a href="/listings" class="btn btn-outline-danger mt-2">Explore Listings</a>
                    </div>
                <% } else { %>
                    <div class="row row-cols-lg-2 row-cols-md-2 row-cols-sm-1">
                        <% for(let listing of user.wishlist) { %>
                            <div class="card listing-card mb-4" style="border: 1px solid #ddd !important; border-radius: 1rem; overflow: hidden; position: relative;">
                                <a href="/listings/<%= listing._id %>" class="listing-link">
                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="image" style="height: 15rem; object-fit: cover;">
                                </a>
                                <form method="POST" action="/wishlist/<%= listing._id %>" class="wishlist-btn-form">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="wishlist-btn" title="Remove from Wishlist">
                                        <i class="fa-solid fa-heart" style="color:crimson;"></i>
                                    </button>
                                </form>
                                <div class="card-body p-3">
                                    <h5 class="card-title text-truncate"><%= listing.title %></h5>
                                    <p class="card-text text-muted mb-2"><i class="fa-solid fa-location-dot"></i> <%= listing.location %></p>
                                    <span class="fw-bold">&#8377 <%= listing.price ? listing.price.toLocaleString() : "N/A" %></span>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
            
            <!-- Reviews Tab -->
            <div class="tab-pane fade" id="reviews-tab-pane" role="tabpanel" aria-labelledby="reviews-tab" tabindex="0">
                <% if(reviewsWithListings.length === 0) { %>
                    <div class="text-center mt-5 text-muted">
                        <i class="fa-solid fa-star mb-3" style="font-size: 3rem; color: #ccc;"></i>
                        <h5>You haven't written any reviews yet.</h5>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 row-cols-md-2 g-4">
                        <% for(let item of reviewsWithListings) { %>
                            <div class="col">
                              <div class="review-airbnb-card">
                                <!-- Listing link -->
                                <a href="/listings/<%= item.listing._id %>" class="d-flex align-items-center mb-3 text-decoration-none" style="color: inherit;">
                                    <img src="<%= item.listing.image.url %>" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                    <h6 class="mb-0 fw-bold text-truncate"><%= item.listing.title %></h6>
                                </a>
                                <!-- Stars + Date -->
                                <div class="d-flex align-items-center mb-2">
                                    <p class="starability-result m-0 me-2" style="transform: scale(0.55); transform-origin: left center;" data-rating="<%= item.review.rating %>"></p>
                                    <span class="text-muted" style="font-size: 0.8rem;"><%= item.review.createdAt ? new Date(item.review.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '' %></span>
                                </div>
                                <!-- Comment with Show more -->
                                <div class="review-text-container">
                                    <p class="review-text-short mb-1" style="line-height: 1.5; font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"><%= item.review.comment %></p>
                                    <p class="review-text-full mb-1" style="line-height: 1.5; font-size: 0.95rem; display: none;"><%= item.review.comment %></p>
                                    <% if (item.review.comment && item.review.comment.length > 120) { %>
                                        <a href="javascript:void(0)" class="show-more-link fw-bold" style="color: #222; text-decoration: underline; font-size: 0.9rem;" onclick="toggleReview(this)">Show more</a>
                                    <% } %>
                                </div>
                              </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Messages Tab -->
            <div class="tab-pane fade" id="messages-tab-pane" role="tabpanel" aria-labelledby="messages-tab" tabindex="0">
                <% if(conversations.length === 0) { %>
                    <div class="text-center mt-5 text-muted">
                        <i class="fa-solid fa-message mb-3" style="font-size: 3rem; color: #ccc;"></i>
                        <h5>No messages yet.</h5>
                        <p>Questions about a stay? Reach out to the host!</p>
                    </div>
                <% } else { %>
                    <div class="row row-cols-1 g-3">
                        <% for(let convo of conversations) { %>
                            <div class="col">
                                <a href="/messages?receiverId=<%= convo.otherUser._id %>&listingId=<%= convo.listing._id %>" class="text-decoration-none text-dark">
                                    <div class="card border-0 shadow-sm rounded-4 p-3" style="background: #fff; transition: 0.3s; border: 1px solid #eee !important;">
                                        <div class="d-flex align-items-center">
                                            <div class="position-relative me-3">
                                                <% if(convo.otherUser.profileImage && convo.otherUser.profileImage.url) { %>
                                                    <img src="<%= convo.otherUser.profileImage.url %>" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid #ff385c;">
                                                <% } else { %>
                                                    <div class="rounded-circle bg-danger text-white d-flex justify-content-center align-items-center" style="width: 50px; height: 50px; font-weight: bold;">
                                                        <%= convo.otherUser.username.charAt(0).toUpperCase() %>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <h6 class="fw-bold mb-0">@<%= convo.otherUser.username %></h6>
                                                    <small class="text-muted"><%= new Date(convo.lastMessage.createdAt).toLocaleDateString() %></small>
                                                </div>
                                                <p class="mb-1 text-muted small text-truncate"><%= convo.lastMessage.content %></p>
                                                <small class="text-danger fw-bold" style="font-size: 0.7rem;"><i class="fa-solid fa-house me-1"></i> <%= convo.listing.title %></small>
                                            </div>
                                            <div class="ms-3">
                                                <i class="fa-solid fa-chevron-right text-muted small"></i>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
// Keep nav tab colors updated on click
document.querySelectorAll('#profileTabs .nav-link').forEach(tab => {
    tab.addEventListener('show.bs.tab', function (e) {
        document.querySelectorAll('#profileTabs .nav-link').forEach(t => {
            t.style.color = '#222';
            t.style.fontWeight = 'normal';
        });
        e.target.style.color = 'crimson';
        e.target.style.fontWeight = 'bold';
    });
});

// Setup Cropper for Profile Image (Aspect ratio 1:1)
document.addEventListener("DOMContentLoaded", () => {
    if (typeof setupImageCropper === 'function') {
        setupImageCropper('profileImage', 'profile-preview', 1);
    }
});

// Overlay Hover Effect
const profileContainer = document.querySelector('.position-relative.d-inline-block.mb-3');
const profileOverlay = document.querySelector('.profile-overlay');
profileContainer.addEventListener('mouseover', () => { profileOverlay.style.opacity = '1'; });
profileContainer.addEventListener('mouseout', () => { profileOverlay.style.opacity = '0'; });

// Show more / Show less for reviews
function toggleReview(link) {
    const container = link.closest('.review-text-container');
    const short = container.querySelector('.review-text-short');
    const full = container.querySelector('.review-text-full');
    if (short.style.display !== 'none') {
        short.style.display = 'none';
        full.style.display = 'block';
        link.textContent = 'Show less';
    } else {
        short.style.display = '-webkit-box';
        full.style.display = 'none';
        link.textContent = 'Show more';
    }
}
    // Delete Listing Confirmation (SweetAlert2)
    document.querySelectorAll('.delete-listing-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const result = await Swal.fire({
                title: 'Delete this Listing?',
                text: "This will permanently remove your hotel from WanderLust. You cannot undo this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ff385c',
                cancelButtonColor: '#222',
                confirmButtonText: 'Yes, delete it',
                background: document.documentElement.getAttribute('data-bs-theme') === 'dark' ? '#1e1e1e' : '#fff',
                color: document.documentElement.getAttribute('data-bs-theme') === 'dark' ? '#fff' : '#222',
                customClass: {
                    popup: 'rounded-4 border-0 shadow-lg',
                    confirmButton: 'rounded-pill px-4',
                    cancelButton: 'rounded-pill px-4'
                }
            });

            if (result.isConfirmed) {
                btn.closest('form').submit();
            }
        });
    });

    // Toggle Edit Profile Section Visibility
    const toggleEditBtn = document.getElementById('toggleEditProfileBtn');
    const editSection = document.getElementById('editProfileSection');
    if (toggleEditBtn && editSection) {
        toggleEditBtn.addEventListener('click', () => {
            const isHidden = editSection.style.display === 'none';
            editSection.style.display = isHidden ? 'block' : 'none';
            toggleEditBtn.innerHTML = isHidden 
                ? '<i class="fa-solid fa-xmark me-2"></i>Close Edit' 
                : '<i class="fa-solid fa-user-pen me-2"></i>Edit Profile';
            if (isHidden) {
                toggleEditBtn.classList.replace('btn-outline-danger', 'btn-secondary');
            } else {
                toggleEditBtn.classList.replace('btn-secondary', 'btn-outline-danger');
            }
        });
    }

// Reliable Instant PDF / Print Receipt Generator
function downloadPdfReceipt(bookingId) {
    const element = document.getElementById(`pdf-receipt-${bookingId}`);
    if (!element) {
        console.error("Receipt element not found for booking ID:", bookingId);
        return;
    }

    const printWindow = window.open('', '_blank', 'width=850,height=900');
    if (!printWindow) {
        alert("Pop-up blocker is preventing receipt window. Please allow pop-ups for localhost.");
        return;
    }

    printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
            <title>WanderLust_Receipt_${bookingId.substring(18)}</title>
            <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
            <style>
                body {
                    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
                    background: #f8f9fa;
                    padding: 40px;
                    margin: 0;
                    display: flex;
                    justify-content: center;
                    color: #222222;
                }
                .invoice-card {
                    background: #ffffff;
                    width: 700px;
                    padding: 40px;
                    border-radius: 16px;
                    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                    border: 1px solid #e0e0e0;
                }
                @media print {
                    body { background: #ffffff; padding: 0; }
                    .invoice-card { box-shadow: none; border: none; width: 100%; padding: 0; }
                    .no-print { display: none !important; }
                }
            </style>
        </head>
        <body>
            <div class="invoice-card">
                ${element.innerHTML}
                <div class="no-print" style="margin-top: 35px; text-align: center; border-top: 1px solid #eeeeee; padding-top: 20px;">
                    <button onclick="window.print()" style="background: linear-gradient(135deg, #ff385c, #e03150); color: white; border: none; padding: 12px 30px; border-radius: 30px; font-weight: 700; font-size: 15px; cursor: pointer; font-family: inherit; margin-right: 10px;">
                        📄 Save as PDF / Print
                    </button>
                    <button onclick="window.close()" style="background: #e4e6eb; color: #333333; border: none; padding: 12px 24px; border-radius: 30px; font-weight: 600; font-size: 15px; cursor: pointer; font-family: inherit;">
                        Close Window
                    </button>
                </div>
            </div>
            <` + `script>
                window.onload = function() {
                    setTimeout(() => {
                        window.print();
                    }, 400);
                };
            <` + `/script>
        </body>
        </html>
    `);
    printWindow.document.close();
}
</script>



