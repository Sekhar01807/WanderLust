<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust Receipt #INV-<%= booking._id.toString().substring(18).toUpperCase() %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f4f6f9;
            color: #222222;
            padding: 40px 15px;
        }
        .receipt-card {
            background: #ffffff;
            max-width: 800px;
            margin: 0 auto;
            border-radius: 20px;
            padding: 45px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.06);
        }
        .brand-logo {
            color: #ff385c;
            font-weight: 800;
            font-size: 30px;
            letter-spacing: -0.5px;
        }
        .table-receipt th {
            background: #f8f9fa;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            border-bottom: 2px solid #dee2e6;
        }
        @media print {
            body { background: white; padding: 0; }
            .receipt-card { box-shadow: none; border: none; padding: 0; max-width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>

    <div class="no-print text-center mb-4">
        <a href="/profile" class="btn btn-outline-secondary rounded-pill px-4 me-2">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Profile
        </a>
        <button id="downloadPdfBtn" class="btn btn-danger rounded-pill px-4 me-2" style="background: linear-gradient(135deg, #ff385c, #e03150); border: none;">
            <i class="fa-solid fa-file-pdf me-2"></i>Download PDF Receipt
        </button>
        <button onclick="window.print()" class="btn btn-dark rounded-pill px-4">
            <i class="fa-solid fa-print me-2"></i>Print Receipt
        </button>
    </div>

    <div class="receipt-card" id="receiptContainer">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4" style="border-bottom-color: #ff385c !important; border-bottom-width: 3px !important;">
            <div>
                <div class="brand-logo"><i class="fa-solid fa-compass me-2"></i>WanderLust</div>
                <p class="text-muted small mb-0">Official Stay E-Receipt & Payment Guarantee</p>
            </div>
            <div class="text-end">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold" style="font-size: 0.85rem;">
                    <i class="fa-solid fa-circle-check me-1"></i>PAID IN FULL
                </span>
                <p class="text-muted small mt-2 mb-0">Receipt #: <strong>INV-<%= booking._id.toString().substring(18).toUpperCase() %></strong></p>
                <p class="text-muted small mb-0">Date: <%= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
            </div>
        </div>

        <!-- Details Grid -->
        <div class="row mb-4">
            <div class="col-6">
                <h6 class="text-muted text-uppercase fw-bold small mb-2">Guest Details</h6>
                <p class="fw-bold mb-1 fs-5"><%= booking.user ? booking.user.username : 'Guest' %></p>
                <p class="text-muted small mb-1"><i class="fa-solid fa-envelope me-1"></i><%= booking.user ? booking.user.email : '' %></p>
                <p class="text-muted small mb-0"><i class="fa-solid fa-phone me-1"></i><%= booking.user ? (booking.user.phoneNumber || 'Registered Member') : '' %></p>
            </div>
            <div class="col-6 text-end">
                <h6 class="text-muted text-uppercase fw-bold small mb-2">Property Details</h6>
                <p class="fw-bold mb-1 fs-5"><%= booking.listing ? booking.listing.title : 'WanderLust Property' %></p>
                <p class="text-muted small mb-1"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing ? booking.listing.location : '' %>, <%= booking.listing ? booking.listing.country : '' %></p>
                <p class="text-muted small mb-0"><i class="fa-solid fa-shield-halved me-1 text-success"></i>Verified Stay Experience</p>
            </div>
        </div>

        <!-- Item Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle table-receipt mb-0">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Check-In</th>
                        <th>Check-Out</th>
                        <th>Guests</th>
                        <th class="text-end">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold"><%= booking.listing ? booking.listing.title : 'Accommodation Reservation' %></td>
                        <td><%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                        <td><%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                        <td><%= booking.guests %> Guest<%= booking.guests > 1 ? 's' : '' %></td>
                        <td class="text-end fw-bold fs-5 text-danger">&#8377 <%= (booking.totalPrice || 0).toLocaleString('en-IN') %></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Summary & Footer -->
        <div class="row align-items-center pt-3 border-top">
            <div class="col-7">
                <p class="small text-muted mb-1"><i class="fa-solid fa-lock me-1 text-success"></i> Payment Method: <strong>Stripe Encrypted Payment</strong></p>
                <p class="small text-muted mb-0"><i class="fa-solid fa-circle-info me-1"></i> Status: <strong>Confirmed & Guaranteed Booking</strong></p>
            </div>
            <div class="col-5 text-end">
                <p class="text-muted small mb-0">Total Amount Paid</p>
                <h2 class="fw-extrabold mb-0" style="color: #ff385c;">&#8377 <%= (booking.totalPrice || 0).toLocaleString('en-IN') %></h2>
            </div>
        </div>

        <div class="text-center border-top mt-5 pt-3">
            <p class="text-muted small mb-0">Thank you for traveling with WanderLust! Wish you a wonderful journey.</p>
        </div>
    </div>

    <script>
    document.getElementById('downloadPdfBtn').addEventListener('click', function() {
        const element = document.getElementById('receiptContainer');
        const opt = {
            margin:       [0.3, 0.3, 0.3, 0.3],
            filename:     'WanderLust_Receipt_INV-<%= booking._id.toString().substring(18).toUpperCase() %>.pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, logging: false },
            jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
        };
        html2pdf().set(opt).from(element).save();
    });
    </script>
</body>
</html>
