<% 
  let initials = "W"; 
  let hostName = "Wanderlust User";
  if (listing.owner && listing.owner.username) {
      hostName = listing.owner.username;
      let names = hostName.split(' ').filter(n => n.length > 0);
      if (names.length >= 2) {
          initials = (names[0].charAt(0) + names[names.length-1].charAt(0)).toUpperCase();
      } else if (names.length === 1) {
          initials = names[0].charAt(0).toUpperCase();
      }
  }
  const ownerId = (listing.owner && listing.owner._id) ? listing.owner._id.toString() : (listing.owner ? listing.owner.toString() : "");
  const isOwner = currUser && ownerId === currUser._id.toString();
%>

<div class="d-flex align-items-center mb-4">
  <% if(listing.owner && listing.owner.profileImage && listing.owner.profileImage.url && !listing.owner.profileImage.url.includes("dwy7q5x2g") && listing.owner.profileImage.url !== "") { %>
      <img src="<%= listing.owner.profileImage.url %>" class="rounded-circle me-3" style="width: 55px; height: 55px; object-fit: cover; border: 2px solid #ff385c;" alt="<%= hostName %>">
  <% } else { %>
      <div class="rounded-circle me-3 d-flex justify-content-center align-items-center bg-danger text-white fw-bold fs-4" style="width: 55px; height: 55px;">
          <%= initials %>
      </div>
  <% } %>
  <div class="flex-grow-1">
    <p class="mb-0 fw-bold fs-5">Hosted by <%= hostName %></p>
    <p class="text-muted mb-0 small">Superhost</p>
  </div>
  <% if (!currUser) { %>
      <a href="/login" class="btn btn-outline-danger rounded-pill px-4 fw-bold shadow-sm">
          <i class="fa-regular fa-comment-dots me-2"></i> Message Host
      </a>
  <% } else if (isOwner) { %>
      <span class="badge rounded-pill bg-light text-muted border px-3 py-2 fw-bold">
          <i class="fa-solid fa-house-user me-1 text-danger"></i> Your Property
      </span>
  <% } else { %>
      <button class="btn text-white rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#chatModal" style="background: linear-gradient(135deg, #ff385c, #e03150); border: none;">
          <i class="fa-regular fa-comment-dots me-2"></i> Message Host / Inquiry
      </button>
  <% } %>
</div>

<hr>

<p class="card-text fs-5 my-4" style="line-height: 1.6;">
  <%= listing.description %>
</p>

<div class="bg-light p-4 rounded-4 mb-3">
  <h5 class="fw-bold mb-3">Listing Details</h5>
  <div class="row">
    <div class="col-md-6 mb-2">
      <i class="fa-solid fa-indian-rupee-sign me-2 text-danger"></i> <span class="fw-bold fs-5"><%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span> <span class="text-muted">/ night</span>
    </div>
    <div class="col-md-6 mb-2">
      <i class="fa-solid fa-location-dot me-2 text-danger"></i> <%= listing.location %>, <%= listing.country %>
    </div>
  </div>
</div>

<% if (isOwner) { %>
<!-- Host Management Controls (Owner View) -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-3 mt-4" style="background: rgba(255, 56, 92, 0.05); border: 2px solid #ff385c !important;">
  <div class="d-flex align-items-center mb-3">
    <i class="fa-solid fa-house-user fs-2 me-3" style="color: #ff385c;"></i>
    <div>
      <h5 class="fw-bold mb-0">Your Property Management</h5>
      <p class="text-muted small mb-0">You are the host & owner of this listing.</p>
    </div>
  </div>
  <div class="row g-2 mt-2">
    <div class="col-12 col-md-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark w-100 fw-bold py-2 rounded-3">
        <i class="fa-solid fa-pen me-1"></i>Edit Property
      </a>
    </div>
    <div class="col-12 col-md-4">
      <a href="/profile" class="btn btn-danger w-100 fw-bold py-2 rounded-3" style="background: linear-gradient(135deg, #ff385c, #e03150); border: none;">
        <i class="fa-solid fa-chart-line me-1"></i>View Reservations
      </a>
    </div>
    <div class="col-12 col-md-4">
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="w-100" id="deleteListingForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="button" class="btn btn-outline-danger w-100 fw-bold py-2 rounded-3" id="deleteListingBtn">
          <i class="fa-solid fa-trash-can me-1"></i>Delete Property
        </button>
      </form>
    </div>
  </div>
</div>
<% } %>
