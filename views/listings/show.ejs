<% layout("/layouts/boilerplate") %>

<div class="container show-listing-container">
  <div class="row mt-4 mb-3">
    <div class="col-12 col-lg-8 offset-lg-2">
      <%- include("../includes/flash.ejs") %>
      <h3 class="fw-bold mb-3"><%= listing.title %></h3>
    </div>
  </div>

  <div class="row mb-5">
    <div class="col-12 col-lg-8 offset-lg-2">
      <!-- Photo Gallery Modal & Dynamic Grid -->
      <%- include("./partials/gallery.ejs") %>

      <div class="card listing-card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
          <!-- Listing Details, Host Profile & Host Management -->
          <%- include("./partials/details.ejs") %>

          <!-- Booking Section, Reschedule UI & Active Stay Status -->
          <%- include("./partials/bookingWidget.ejs") %>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4 mb-5">
    <div class="col-12 col-lg-10 offset-lg-1">
      <!-- Verified Stay Reviews & Star Rating Picker -->
      <%- include("./partials/reviews.ejs") %>

      <!-- Universal Interactive Map (Mapbox GL & Leaflet Fallback) -->
      <%- include("./partials/map.ejs") %>
    </div>
  </div>
</div>

<!-- Host Direct Messaging Modal -->
<%- include("./partials/chatModal.ejs") %>