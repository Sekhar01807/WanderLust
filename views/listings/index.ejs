<% layout("/layouts/boilerplate") %>
<body>
    <%- include("../includes/flash.ejs") %>
    <div class="filters-main-container d-flex align-items-center mt-3 mb-4 gap-2 position-relative mx-auto px-md-3" style="max-width: 95%;">

        <!-- Scroll Left Button -->
        <button type="button" id="filterScrollLeft" class="btn btn-light rounded-circle shadow-sm border d-none d-md-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 32px; height: 32px; z-index: 10;" title="Scroll Left">
            <i class="fa-solid fa-chevron-left" style="font-size: 0.8rem;"></i>
        </button>

        <!-- Category Pills Track -->
        <div id="filter" class="d-flex flex-nowrap overflow-auto flex-grow-1 align-items-center py-1 px-2" style="scrollbar-width: none; -ms-overflow-style: none; scroll-behavior: smooth; gap: 3.2rem;">

            <a href="/listings" class="filter-link">
                <div class="filter <%= category === 'all' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-border-all"></i></div>
                    <p>All</p>
                </div>
            </a>
            <a href="/listings?category=trending" class="filter-link">
                <div class="filter <%= category === 'trending' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-fire"></i></div>
                    <p>Trending</p>
                </div>
            </a>
            <a href="/listings?category=rooms" class="filter-link">
                <div class="filter <%= category === 'rooms' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-bed"></i></div>
                    <p>Rooms</p>
                </div>
            </a>
            <a href="/listings?category=cities" class="filter-link">
                <div class="filter <%= category === 'cities' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-city"></i></div>
                    <p>Cities</p>
                </div>
            </a>
            <a href="/listings?category=pools" class="filter-link">
                <div class="filter <%= category === 'pools' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p>Pools</p>
                </div>
            </a>
            <a href="/listings?category=hills" class="filter-link">
                <div class="filter <%= category === 'hills' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-mountain"></i></div>
                    <p>Hills</p>
                </div>
            </a>
            <a href="/listings?category=star_hotels" class="filter-link">
                <div class="filter <%= category === 'star_hotels' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-hotel"></i></div>
                    <p>Hotels</p>
                </div>
            </a>
            <a href="/listings?category=private_house" class="filter-link">
                <div class="filter <%= category === 'private_house' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-house-user"></i></div>
                    <p>Private</p>
                </div>
            </a>
            <a href="/listings?category=best_deals" class="filter-link">
                <div class="filter <%= category === 'best_deals' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-tag"></i></div>
                    <p>Deals</p>
                </div>
            </a>
            <a href="/listings?category=premium" class="filter-link">
                <div class="filter <%= category === 'premium' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-crown"></i></div>
                    <p>Premium</p>
                </div>
            </a>
            <a href="/listings?category=nearby" class="filter-link">
                <div class="filter <%= category === 'nearby' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-location-dot"></i></div>
                    <p>Nearby</p>
                </div>
            </a>

            <a href="/listings?category=beachfront" class="filter-link">
                <div class="filter <%= category === 'beachfront' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-umbrella-beach"></i></div>
                    <p>Beachfront</p>
                </div>
            </a>
            <a href="/listings?category=camping" class="filter-link">
                <div class="filter <%= category === 'camping' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-tent"></i></div>
                    <p>Camping</p>
                </div>
            </a>
            <a href="/listings?category=castles" class="filter-link">
                <div class="filter <%= category === 'castles' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-chess-rook"></i></div>
                    <p>Castles</p>
                </div>
            </a>
            <a href="/listings?category=arctic" class="filter-link">
                <div class="filter <%= category === 'arctic' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-snowflake"></i></div>
                    <p>Arctic</p>
                </div>
            </a>
            <a href="/listings?category=others" class="filter-link">
                <div class="filter <%= category === 'others' ? 'filter-active' : '' %>">
                    <div><i class="fa-solid fa-sliders"></i></div>
                    <p>Others</p>
                </div>
            </a>

        </div>

        <!-- Scroll Right Button -->
        <button type="button" id="filterScrollRight" class="btn btn-light rounded-circle shadow-sm border d-none d-md-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 32px; height: 32px; z-index: 10;" title="Scroll Right">
            <i class="fa-solid fa-chevron-right" style="font-size: 0.8rem;"></i>
        </button>
    </div>


    <% if(search && search.trim()) { %>
        <div class="mt-3 mb-2 d-flex align-items-center">
            <span class="text-muted">Results for "<strong><%= search %></strong>" — <%= allListings.length %> found</span>
            <a href="/listings" class="btn btn-sm btn-outline-secondary ms-3">Clear Search</a>
        </div>
    <% } %>

    <% if(allListings.length === 0) { %>
        <div class="text-center mt-5 mb-5">
            <i class="fa-solid fa-magnifying-glass" style="font-size:3rem;color:#ccc;"></i>
            <h4 class="mt-3 text-muted">No listings found</h4>
            <p class="text-muted">Try a different search or category</p>
            <a href="/listings" class="btn btn-outline-danger">View All Listings</a>
        </div>
    <% } else { %>
    <div id="listingsGridContainer" class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings){ %>
            <div class="col mb-4">
                <div class="card listing-card shadow-sm border-0 rounded-4 overflow-hidden h-100 position-relative">
                    <div class="listing-img-container position-relative" style="overflow: hidden; border-radius: 1rem;">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <img src="<%= listing.image ? listing.image.url : '' %>" class="card-img-top" alt="listing_image" style="height:20rem; object-fit:cover; border-radius: 1rem !important;">
                            <div class="card-img-overlay"></div>
                            <!-- Hover overlay (Customized for Host vs Guest) -->
                            <% const isListingOwner = typeof currUser !== 'undefined' && currUser && listing.owner && (listing.owner._id ? listing.owner._id.toString() === currUser._id.toString() : listing.owner.toString() === currUser._id.toString()); %>
                            <div class="book-now-overlay">
                                <% if (isListingOwner) { %>
                                    <span class="book-now-text" style="background: rgba(33, 37, 41, 0.9);"><i class="fa-solid fa-house-user me-2"></i>Your Listing</span>
                                <% } else { %>
                                    <span class="book-now-text"><i class="fa-solid fa-calendar-check me-2"></i>Book Now</span>
                                <% } %>
                            </div>
                        </a>

                        <!-- Floating Wishlist Heart Icon -->
                        <div class="wishlist-btn-form position-absolute" style="top: 12px; right: 12px; z-index: 10;">
                            <% const isWishlisted = typeof currUser !== 'undefined' && currUser && currUser.wishlist && currUser.wishlist.some(w => (w ? w.toString() : '') === listing._id.toString()); %>
                            <button type="button" class="wishlist-btn" title="Toggle Wishlist" data-listing-id="<%= listing._id %>" data-logged-in="<%= (typeof currUser !== 'undefined' && currUser) ? 'true' : 'false' %>">
                                <i class="<%= isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>" style="<%= isWishlisted ? 'color: #ff385c !important;' : '' %>"></i>
                            </button>
                        </div>
                    </div>
                
                <a href="/listings/<%= listing._id %>" class="listing-link" style="text-decoration:none; color:inherit;">
                    <div class="card-body">
                        <h4 class="card-title"><%= listing.title %></h4>
                        <p class="card-text mb-1 text-muted"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
                        <p class="card-text mb-1"><%= listing.description %></p>
                        <p class="card-text">
                            <strong>&#8377 <%= listing.price ? listing.price.toLocaleString() : "N/A" %></strong> / Night
                        </p>
                    </div>
                </a>
            </div>
            </div>
        <% } %>
    </div>
    <% } %>

<script>
    // Filter Bar Scroll Navigation Controls & Active Icon Auto-Centering
    const filterTrack = document.getElementById('filter');
    const scrollLeftBtn = document.getElementById('filterScrollLeft');
    const scrollRightBtn = document.getElementById('filterScrollRight');

    if (filterTrack && scrollLeftBtn && scrollRightBtn) {
        scrollLeftBtn.addEventListener('click', () => {
            filterTrack.scrollBy({ left: -260, behavior: 'smooth' });
        });
        scrollRightBtn.addEventListener('click', () => {
            filterTrack.scrollBy({ left: 260, behavior: 'smooth' });
        });
    }

    // Auto-scroll active filter pill into view on page load
    document.addEventListener('DOMContentLoaded', () => {
        const activeFilter = document.querySelector('.filter-active');
        if (activeFilter && filterTrack) {
            const activeLink = activeFilter.closest('.filter-link');
            if (activeLink) {
                const trackRect = filterTrack.getBoundingClientRect();
                const linkRect = activeLink.getBoundingClientRect();
                const scrollOffset = (linkRect.left + filterTrack.scrollLeft) - (trackRect.left + (trackRect.width / 2) - (linkRect.width / 2));
                filterTrack.scrollTo({ left: scrollOffset, behavior: 'smooth' });
            }
        }
    });

    // Wishlist AJAX Toggle (with SweetAlert2 Toasts & Event Delegation)
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 2500,
        timerProgressBar: true,
        background: document.documentElement.getAttribute('data-bs-theme') === 'dark' ? '#1e1e1e' : '#fff',
        color: document.documentElement.getAttribute('data-bs-theme') === 'dark' ? '#fff' : '#222',
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer);
            toast.addEventListener('mouseleave', Swal.resumeTimer);
        }
    });

    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.wishlist-btn');
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        const isLoggedIn = btn.dataset.loggedIn === 'true';
        if (!isLoggedIn) {
            Toast.fire({
                icon: 'warning',
                title: 'Please log in to save to your wishlist!'
            });
            setTimeout(() => {
                window.location.href = '/login';
            }, 1200);
            return;
        }

        const listingId = btn.dataset.listingId;
        const icon = btn.querySelector('i');
        const cookieMatch = document.cookie.match(/(?:^|;\s*)XSRF-TOKEN=([^;]*)/);
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || (cookieMatch ? decodeURIComponent(cookieMatch[1]) : '');

        // Instant optimistic toggle
        const wasSolid = icon.classList.contains('fa-solid');
        if (!wasSolid) {
            icon.className = 'fa-solid fa-heart';
            icon.style.setProperty('color', '#ff385c', 'important');
            btn.style.transform = 'scale(1.25)';
            setTimeout(() => btn.style.transform = '', 200);
            Toast.fire({
                icon: 'success',
                title: 'Saved to Wishlist ❤️'
            });
        } else {
            icon.className = 'fa-regular fa-heart';
            icon.style.removeProperty('color');
            btn.style.transform = 'scale(0.85)';
            setTimeout(() => btn.style.transform = '', 200);
            Toast.fire({
                icon: 'info',
                title: 'Removed from Wishlist'
            });
        }

        try {
            const res = await fetch(`/wishlist/${listingId}?_csrf=${encodeURIComponent(csrfToken)}`, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-Token': csrfToken,
                    'csrf-token': csrfToken
                },
                body: JSON.stringify({ _csrf: csrfToken })
            });

            if (res.status === 401) {
                window.location.href = '/login';
                return;
            }

            if (!res.ok) {
                // Revert state on server error
                if (wasSolid) {
                    icon.className = 'fa-solid fa-heart';
                    icon.style.setProperty('color', '#ff385c', 'important');
                } else {
                    icon.className = 'fa-regular fa-heart';
                    icon.style.removeProperty('color');
                }
                Toast.fire({
                    icon: 'error',
                    title: 'Could not update wishlist'
                });
            }
        } catch (err) {
            console.error('Wishlist toggle error:', err);
            // Revert state on network error
            if (wasSolid) {
                icon.className = 'fa-solid fa-heart';
                icon.style.setProperty('color', '#ff385c', 'important');
            } else {
                icon.className = 'fa-regular fa-heart';
                icon.style.removeProperty('color');
            }
            Toast.fire({
                icon: 'error',
                title: 'Network error. Please try again.'
            });
        }
    });
</script>